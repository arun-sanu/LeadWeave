{
    "name": "rmyndharis/leadweave",
    "description": "Official PHP SDK for LeadWeave WhatsApp API Gateway",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "whatsapp",
        "api",
        "sdk",
        "leadweave",
        "gateway"
    ],
    "authors": [
        {
            "name": "LeadWeave Contributors"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "LeadWeave\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LeadWeave\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.5.x-dev"
        }
    }
}
